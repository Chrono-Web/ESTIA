# Configurazione del lab M0.2. Copiare in .env e compilare durante E0.
# .env non va committato: puo' contenere il dominio reale usato per lo spike.

# Versioni fissate durante E0, insieme a licenza e architetture supportate.
# Non esiste un default: la scelta e' un risultato dello spike.
HEADSCALE_VERSION=
CADDY_VERSION=

# Nome DNS che punta all'host pubblico del lab.
LAB_DOMAIN=
