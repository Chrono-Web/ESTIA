# The bind address and port used by Docker Compose on the host.
ESTIA_BIND_ADDRESS=127.0.0.1
ESTIA_HOST_PORT=3000

# Core API configuration.
ESTIA_HOST=0.0.0.0
ESTIA_PORT=3000
ESTIA_LOG_LEVEL=info

# Where the database, the instance identity and the media are stored. Under
# Docker this is overridden to /data by the image and by the Compose file.
ESTIA_DATA_DIR=./.data

# Media limits. The browser compresses before uploading, so these are the room
# left above what it sends, not a target: an image past either threshold is
# refused. The pixel limit is separate from the byte one because a small file
# can decompress into a very large picture.
ESTIA_MEDIA_MAX_BYTES=5242880
ESTIA_MEDIA_MAX_PIXELS=12000000

# How much one member may hold, originals and thumbnails together.
ESTIA_MEDIA_QUOTA_BYTES=268435456

# Scheduled backups. Both empty means the instance takes none, and says so in
# its logs. Generate the pair with `node dist/backup/cli.js chiavi`, put the
# PUBLIC half here, and keep the private half off this machine: that is what
# stops the instance from being able to read its own archives.
ESTIA_BACKUP_DIR=
ESTIA_BACKUP_PUBLIC_KEY=
ESTIA_BACKUP_INTERVAL_HOURS=24
ESTIA_BACKUP_KEEP=7

# Container resource limits. Empty or 0 means no limit, which is the default
# for memory on purpose: an archive is encrypted whole in memory, and measuring
# showed a backup needs about six times the size of the data (1.25 GB for
# 200 MB, 2.5 GB for 400 MB). A limit below that does not fail the backup with
# an error — the kernel kills the process. Set it if you want ESTIA not to be
# able to take the whole NAS down with it, and size it against your data; the
# instance says so in its diagnostics when the limit is too small.
ESTIA_MEMORY_LIMIT=
ESTIA_CPU_LIMIT=

# What the administrator declares about volume encryption: passphrase,
# automatic or none. The instance verifies what it can and flags a declaration
# it cannot see (ADR 0007). Empty means "not declared", never "none".
ESTIA_AT_REST_ENCRYPTION=
