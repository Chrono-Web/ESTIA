# The bind address and port used by Docker Compose on the host.
ESTIA_BIND_ADDRESS=127.0.0.1
ESTIA_HOST_PORT=3000

# Core API configuration.
ESTIA_HOST=0.0.0.0
ESTIA_PORT=3000
ESTIA_LOG_LEVEL=info

# Where the database and the instance identity are stored. Under Docker this is
# overridden to /data by the image and by the Compose file.
ESTIA_DATA_DIR=./.data
