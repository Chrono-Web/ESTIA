# estia_completezza LINGUA — quanto e' tradotta, in percentuale (ADR 0044 §4).
estia_completezza() {
	case "$1" in
	it) printf '%s' 100 ;;
	en) printf '%s' 100 ;;
	*) printf '%s' 0 ;;
	esac
}
# i18n:fine

# lingua_da_locale VALORE — `en_US.UTF-8` → `en-US`. `C` e `POSIX` non nominano
# nessuna lingua, e falliscono.
lingua_da_locale() {
	_ll="${1%%.*}"
	_ll="${_ll%%@*}"
	case "$_ll" in
	"" | C | POSIX)
		return 1
		;;
	esac
	printf '%s' "$_ll" | tr '_' '-'
}

minuscole() {
	printf '%s' "$1" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz'
}

# lingua_disponibile DESIDERIO — il codice di ESTIA_LINGUE che gli risponde,
# prima per intero (`pt-BR`), poi per la lingua principale (`en-GB` → `en`).
lingua_disponibile() {
	_ld=$(lingua_da_locale "$1") || return 1
	_ld=$(minuscole "$_ld")
	for _lc in $ESTIA_LINGUE; do
		if [ "$(minuscole "$_lc")" = "$_ld" ]; then
			printf '%s' "$_lc"
			return 0
		fi
	done
	for _lc in $ESTIA_LINGUE; do
		if [ "$(minuscole "$_lc")" = "${_ld%%-*}" ]; then
			printf '%s' "$_lc"
			return 0
		fi
	done
	return 1
}

# scegli_lingua [PREFERITA] — ESTIA_LANG, poi PREFERITA, poi LC_ALL,
# LC_MESSAGES e LANG, poi l'inglese.
scegli_lingua() {
	for _ls in "${ESTIA_LANG:-}" "${1:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
		if lingua_disponibile "$_ls"; then
			return 0
		fi
	done
	printf '%s' en
}

# t CHIAVE [NOME VALORE]... — la frase nella lingua scelta, altrimenti in
# inglese, altrimenti in italiano, con ogni {{NOME}} sostituito da VALORE.
#
# La sostituzione la fa awk leggendo tutto da ENVIRON: un valore con `/`, `&`,
# `\` o apici resta com'e', cosa che sed con il valore dentro l'espressione non
# garantisce. Il colore di un valore lo mette chi chiama, nel valore stesso.
t() {
	_tk="$1"
	shift
	if estia_frase "$LINGUA" "$_tk" || estia_frase en "$_tk" || estia_frase it "$_tk"; then
		_tf="$ESTIA_FRASE"
	else
		_tf="$_tk"
	fi
	while [ "$#" -ge 2 ]; do
		case "$_tf" in
		*"{{$1}}"*)
			_tf=$(ESTIA_T_FRASE="$_tf" ESTIA_T_NOME="{{$1}}" ESTIA_T_VALORE="$2" awk 'BEGIN {
				s = ENVIRON["ESTIA_T_FRASE"]
				k = ENVIRON["ESTIA_T_NOME"]
				v = ENVIRON["ESTIA_T_VALORE"]
				out = ""
				while ((i = index(s, k)) > 0) {
					out = out substr(s, 1, i - 1) v
					s = substr(s, i + length(k))
				}
				printf "%s", out s
			}')
			;;
		esac
		shift 2
	done
	printf '%s' "$_tf"
}

# larghezza TESTO — le colonne che occupa: i caratteri, non i byte (di UTF-8 si
# scartano i byte di continuazione). Giusto per gli alfabeti dei cataloghi di
# oggi; le icone delle cornici le conta `cornice` a parte.
larghezza() {
	printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

ripeti() {
	_rr=""
	_rn="$2"
	while [ "$_rn" -gt 0 ]; do
		_rr="$_rr$1"
		_rn=$((_rn - 1))
	done
	printf '%s' "$_rr"
}

# colonna MINIMO ETICHETTA... — dove comincia il valore in un elenco di
# etichette: almeno a MINIMO, e sempre uno spazio dopo la piu' lunga, perche'
# un'etichetta tradotta puo' essere piu' lunga di quella italiana.
colonna() {
	_cm="$1"
	shift
	for _ct in "$@"; do
		_cw=$(($(larghezza "$_ct") + 1))
		if [ "$_cw" -gt "$_cm" ]; then
			_cm="$_cw"
		fi
	done
	printf '%s' "$_cm"
}

# allinea COLONNA TESTO — il testo, e gli spazi che lo portano alla colonna.
allinea() {
	_aw=$(($1 - $(larghezza "$2")))
	if [ "$_aw" -lt 1 ]; then
		_aw=1
	fi
	printf '%s%s' "$2" "$(ripeti ' ' "$_aw")"
}


# La lingua predefinita dell'istanza, chiesta al container. Vuota se Docker non
# c'e', se il container e' spento o se l'istanza non e' ancora configurata; e
# non si chiede nemmeno quando ESTIA_LANG ha gia' risposto.
lingua_istanza() {
	if ! command -v docker >/dev/null 2>&1; then
		return 0
	fi
	docker exec "$NAME" node -e 'fetch("http://127.0.0.1:" + (process.env.ESTIA_PORT || "3000") + "/api/v1/instance", { signal: AbortSignal.timeout(3000) }).then((r) => r.json()).then((j) => console.log(j.defaultLanguage ?? "")).catch(() => {})' 2>/dev/null || true
}

if lingua_disponibile "${ESTIA_LANG:-}" >/dev/null; then
	LINGUA=$(scegli_lingua)
else
	LINGUA=$(scegli_lingua "$(lingua_istanza)")
fi

# I comandi hanno un nome italiano e uno inglese (`estia stato` e `estia status`
# sono lo stesso comando, vedi in fondo): a chi legge in un'altra lingua si
# mostrano gli inglesi.
if [ "$LINGUA" = it ]; then
	CMD_STATO="estia stato"
	CMD_RIPRISTINO="estia ripristino-backup"
	CMD_AGGIORNA="estia aggiorna"
	CMD_RIAVVIA="estia riavvia"
	CMD_CHIAVI="estia chiavi"
	CMD_AIUTO="estia aiuto"
else
	CMD_STATO="estia status"
	CMD_RIPRISTINO="estia restore"
	CMD_AGGIORNA="estia update"
	CMD_RIAVVIA="estia restart"
	CMD_CHIAVI="estia keys"
	CMD_AIUTO="estia help"
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	ESC=$(printf '\033')
	C0="${ESC}[0m"
	C1="${ESC}[1m"
	CDIM="${ESC}[2m"
	CCYAN="${ESC}[1;36m"
	CBLUE="${ESC}[4;34m"
	CGREEN="${ESC}[32m"
	CYELLOW="${ESC}[33m"
	CRED="${ESC}[31m"
else
	C0=""
	C1=""
	CDIM=""
	CCYAN=""
	CBLUE=""
	CGREEN=""
	CYELLOW=""
	CRED=""
fi

RAMO="   ${CCYAN}├──${C0}"
ULTIMO="   ${CCYAN}└──${C0}"

# Si stampa sempre con %s: i colori sono gia' byte veri, e un percorso o una
# frase con una barra rovesciata devono uscire come sono.
say() {
	printf '%s\n' "$*"
}

die() {
	printf '\n%s\n' "${CRED}${C1}$(t cli.error)${C0} $*" >&2
	exit 1
}

ok() {
	say "${CGREEN}●${C0} $*"
}

avviso() {
	say "${CYELLOW}○${C0} $*"
}

# cornice ICONA TITOLO — il riquadro dei titoli, largo 68 colonne o di piu' se
# il titolo, in quella lingua, e' piu' lungo. L'icona occupa due colonne.
cornice() {
	_cl=$(($(larghezza "$2") + 5))
	_ci=68
	if [ "$((_cl + 1))" -gt "$_ci" ]; then
		_ci=$((_cl + 1))
	fi
	_cb=$(ripeti '═' "$_ci")
	say ""
	say "${CCYAN}╔${_cb}╗"
	say "║  $1 $2$(ripeti ' ' $((_ci - _cl)))║"
	say "╚${_cb}╝${C0}"
}

sezione() {
	say ""
	say "$1 ${C1}$2${C0}"
}

# comando RAMO COLONNA COMANDO DESCRIZIONE — una riga di un elenco di comandi.
comando() {
	say "$1 ${C1}$(allinea "$2" "$3")${C0}$4"
}

check_docker() {
	if ! command -v docker >/dev/null 2>&1; then
		die "$(t cli.docker.missing)"
	fi
	if ! docker info >/dev/null 2>&1; then
		die "$(t cli.docker.not_responding)"
	fi
}

mostra_aiuto() {
	cornice "🏡" "$(t cli.help.title)"
	say ""
	say "🛠  ${C1}$(t cli.help.commands)${C0}"
	comando "$RAMO" 28 "estia info" "$(t cli.help.info)"
	comando "$RAMO" 28 "$CMD_STATO" "$(t cli.help.status)"
	comando "$RAMO" 28 "$CMD_RIPRISTINO" "$(t cli.help.restore)"
	comando "$RAMO" 28 "estia backup" "$(t cli.help.backup)"
	comando "$RAMO" 28 "$CMD_CHIAVI" "$(t cli.help.keys)"
	comando "$RAMO" 28 "estia logs [-f]" "$(t cli.help.logs)"
	comando "$RAMO" 28 "$CMD_AGGIORNA" "$(t cli.help.update)"
	comando "$RAMO" 28 "$CMD_RIAVVIA" "$(t cli.help.restart)"
	comando "$ULTIMO" 28 "$CMD_AIUTO" "$(t cli.help.help)"
	say ""
	say "📖 ${CDIM}$(t cli.docs url "$DOCS_URL")${C0}"
	say ""
}

cmd_info() {
	check_docker

	HOSTNAME_LOCAL="$(hostname 2>/dev/null | cut -d. -f1)"
	HOSTNAME_LOCAL="${HOSTNAME_LOCAL:-localhost}"

	STATUS="$(t cli.info.absent)"
	PORT="3000"
	DATA_MOUNT="$(t cli.info.default_volume volume "$VOLUME")"
	BACKUP_MOUNT="/data/backup"

	if docker container inspect "$NAME" >/dev/null 2>&1; then
		IS_RUNNING="$(docker inspect -f '{{.State.Running}}' "$NAME")"
		if [ "$IS_RUNNING" = "true" ]; then
			STATUS="${CGREEN}● $(t cli.state.running)${C0}"
		else
			STATUS="${CYELLOW}○ $(t cli.state.stopped)${C0}"
		fi

		DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$DETECTED_PORT" ]; then
			PORT="$DETECTED_PORT"
		fi

		MOUNT_DATA="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$MOUNT_DATA" ]; then
			DATA_MOUNT="$MOUNT_DATA"
		fi

		MOUNT_BACKUP="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data/backup"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$MOUNT_BACKUP" ]; then
			BACKUP_MOUNT="$MOUNT_BACKUP"
		fi
	fi

	L_WEB=$(t cli.label.web)
	L_CONTAINER=$(t cli.label.container)
	L_PORT=$(t cli.label.port)
	L_DATA=$(t cli.label.data_volume)
	L_BACKUP=$(t cli.label.backup)
	L_BACKUP_CRYPTO=$(t cli.label.backup_crypto)
	L_MESSAGES=$(t cli.label.messages)
	W=$(colonna 16 "$L_WEB" "$L_CONTAINER" "$L_PORT" "$L_DATA" "$L_BACKUP" "$L_BACKUP_CRYPTO" "$L_MESSAGES")

	cornice "🏡" "$(t cli.info.title)"
	say ""
	say "📍 ${C1}$(t cli.info.access)${C0}"
	say "$RAMO $(allinea "$W" "$L_WEB")${CBLUE}http://${HOSTNAME_LOCAL}.local:${PORT}${C0}"
	say "$RAMO $(allinea "$W" "$L_CONTAINER")${NAME} (${STATUS})"
	say "$ULTIMO $(allinea "$W" "$L_PORT")${PORT}"
	say ""
	say "💾 ${C1}$(t cli.info.data)${C0}"
	say "$RAMO $(allinea "$W" "$L_DATA")${DATA_MOUNT} → /data"
	say "$ULTIMO $(allinea "$W" "$L_BACKUP")${BACKUP_MOUNT}"
	say ""
	say "🔐 ${C1}$(t cli.info.crypto)${C0}"
	say "$RAMO $(allinea "$W" "$L_BACKUP_CRYPTO")$(t cli.info.backup_crypto)"
	say "$ULTIMO $(allinea "$W" "$L_MESSAGES")$(t cli.info.messages_crypto)"
	say ""
	say "🛠  ${C1}$(t cli.info.commands)${C0}"
	comando "$RAMO" 28 "estia info" "$(t cli.info.cmd.info)"
	comando "$RAMO" 28 "$CMD_STATO" "$(t cli.info.cmd.status)"
	comando "$RAMO" 28 "$CMD_RIPRISTINO" "$(t cli.info.cmd.restore)"
	comando "$RAMO" 28 "estia backup" "$(t cli.info.cmd.backup)"
	comando "$RAMO" 28 "$CMD_CHIAVI" "$(t cli.help.keys)"
	comando "$RAMO" 28 "estia logs -f" "$(t cli.info.cmd.logs)"
	comando "$RAMO" 28 "$CMD_AGGIORNA" "$(t cli.info.cmd.update)"
	comando "$ULTIMO" 28 "$CMD_RIAVVIA" "$(t cli.info.cmd.restart)"
	say ""
	say "📖 ${CDIM}$(t cli.info.setup_code command "estia logs")${C0}"
	say "📖 ${CDIM}$(t cli.info.docs url "$DOCS_URL")${C0}"
	say ""
}

cmd_chiavi() {
	check_docker
	cornice "🔑" "$(t cli.keys.title)"
	docker run --rm --env ESTIA_LANG="$LINGUA" --entrypoint node "$IMAGE" dist/backup/cli.js chiavi
}

cmd_logs() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "$(t cli.container.missing name "$NAME")"
	fi
	docker logs "$@" "$NAME"
}

cmd_stato() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		L_INSTALL=$(t cli.label.install)
		L_DOCS=$(t cli.label.docs)
		W=$(colonna 17 "$L_INSTALL" "$L_DOCS")
		cornice "📊" "$(t cli.status.title)"
		avviso "$(t cli.status.absent name "$NAME")"
		say "$RAMO $(allinea "$W" "$L_INSTALL")${C1}curl -fsSL ${INSTALL_URL} | sh${C0}"
		say "$ULTIMO $(allinea "$W" "$L_DOCS")${CBLUE}${DOCS_URL}${C0}"
		return
	fi

	STATUS_RAW="$(docker inspect -f '{{.State.Status}}' "$NAME")"
	if [ "$STATUS_RAW" = "running" ]; then
		STATUS="${CGREEN}● $(t cli.state.running)${C0}"
	else
		STATUS="${CYELLOW}○ ${STATUS_RAW}${C0}"
	fi
	IMAGE_ID="$(docker inspect -f '{{.Config.Image}}' "$NAME")"
	CREATED="$(docker inspect -f '{{.Created}}' "$NAME" | cut -d. -f1 | tr 'T' ' ')"
	STARTED="$(docker inspect -f '{{.State.StartedAt}}' "$NAME" | cut -d. -f1 | tr 'T' ' ')"
	DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
	DETECTED_PORT="${DETECTED_PORT:-3000}"

	L_NAME=$(t cli.label.name)
	L_IMAGE=$(t cli.label.image)
	L_PORT=$(t cli.label.port)
	L_CREATED=$(t cli.label.created)
	L_LAST_START=$(t cli.label.last_start)
	L_ISOLATION=$(t cli.label.isolation)
	L_USER=$(t cli.label.user)
	L_PRIVILEGES=$(t cli.label.privileges)
	L_PID=$(t cli.label.pid_limit)
	W=$(colonna 14 "$L_NAME" "$L_IMAGE" "$L_PORT" "$L_CREATED" "$L_LAST_START" "$L_ISOLATION" "$L_USER" "$L_PRIVILEGES" "$L_PID")

	cornice "📊" "$(t cli.status.title)"

	sezione "📍" "$(t cli.status.container)"
	say "$RAMO $(allinea "$W" "$L_NAME")${C1}$NAME${C0} ($STATUS)"
	say "$RAMO $(allinea "$W" "$L_IMAGE")$IMAGE_ID"
	say "$RAMO $(allinea "$W" "$L_PORT")${DETECTED_PORT} → 3000 (host:container)"
	say "$RAMO $(allinea "$W" "$L_CREATED")$CREATED"
	say "$ULTIMO $(allinea "$W" "$L_LAST_START")$STARTED"

	sezione "💾" "$(t cli.status.mounts)"
	# Docker scrive i campi, e le righe le compone lo script: dentro il modello
	# di `docker inspect` i colori non arriverebbero.
	docker inspect -f '{{range .Mounts}}{{.Type}}|{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}|{{.Destination}}{{"\n"}}{{end}}' "$NAME" |
		while IFS='|' read -r _tipo _origine _destinazione; do
			if [ -n "$_tipo" ]; then
				say "$RAMO ${_tipo}: ${_origine} → ${_destinazione}"
			fi
		done
	say "$ULTIMO $(allinea "$W" "$L_ISOLATION")$(t cli.status.isolation)"

	sezione "🔒" "$(t cli.status.security)"
	say "$RAMO $(allinea "$W" "$L_USER")non-root (10001:10001)"
	say "$RAMO $(allinea "$W" "$L_PRIVILEGES")no-new-privileges:true, cap-drop ALL"
	say "$ULTIMO $(allinea "$W" "$L_PID")$(t cli.status.pid_value limit 256)"

	W=$(colonna 16 "estia logs -f" "$CMD_RIAVVIA" "estia backup")
	sezione "🛠 " "$(t cli.status.actions)"
	comando "$RAMO" "$W" "estia logs -f" "$(t cli.info.cmd.logs)"
	comando "$RAMO" "$W" "$CMD_RIAVVIA" "$(t cli.info.cmd.restart)"
	comando "$ULTIMO" "$W" "estia backup" "$(t cli.info.cmd.backup)"
}

# risultato_riavvio — lo stato e i due comandi che servono dopo un riavvio.
risultato_riavvio() {
	L_STATE=$(t cli.label.state)
	L_DIAGNOSTICS=$(t cli.label.diagnostics)
	L_LOGS=$(t cli.label.logs)
	W=$(colonna 10 "$L_STATE" "$L_DIAGNOSTICS" "$L_LOGS")
	say "$RAMO $(allinea "$W" "$L_STATE")${CGREEN}● $(t cli.state.running)${C0}"
	say "$RAMO $(allinea "$W" "$L_DIAGNOSTICS")${C1}${CMD_STATO}${C0}"
	say "$ULTIMO $(allinea "$W" "$L_LOGS")${C1}estia logs -f${C0}"
}

cmd_riavvia() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "$(t cli.container.missing name "$NAME")"
	fi
	cornice "🔄" "$(t cli.restart.title)"
	say "${CCYAN}→${C0} $(t cli.restart.running name "$NAME")"
	docker restart "$NAME" >/dev/null
	say ""
	ok "${C1}$(t cli.restart.done name "$NAME")${C0}"
	risultato_riavvio
}

cmd_backup() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "$(t cli.container.missing_or_stopped name "$NAME")"
	fi
	DEST="${1:-/data/backup}"
	cornice "💾" "$(t cli.backup.title)"
	say "${CCYAN}→${C0} $(t cli.backup.running path "${C1}${DEST}${C0}")"
	say ""
	docker exec -it --env ESTIA_LANG="$LINGUA" "$NAME" node dist/backup/cli.js backup "$DEST"
}

cmd_ripristina() {
	check_docker
	ARCHIVIO="${1:-}"

	cornice "🔐" "$(t cli.restore.title)"

	# 1. Chiedi il file se non passato come argomento
	say "${C1}1. $(t cli.restore.step_file)${C0}"
	if [ -z "$ARCHIVIO" ]; then
		say "   $(t cli.restore.ask_path)"
		printf '%s' "   > "
		read -r ARCHIVIO || ARCHIVIO=""
	fi

	# Pulizia percorso (rimuove apici singoli o doppi aggiunti dai terminali con drag & drop)
	ARCHIVIO="$(printf '%s' "$ARCHIVIO" | sed -e "s/^['\"]//" -e "s/['\"]$//")"
	case "$ARCHIVIO" in
		"~"*) ARCHIVIO="$HOME${ARCHIVIO#\~}" ;;
	esac

	if [ -z "$ARCHIVIO" ]; then
		die "$(t cli.restore.no_path)"
	fi

	if [ ! -f "$ARCHIVIO" ]; then
		die "$(t cli.restore.file_missing path "$ARCHIVIO")"
	fi

	ARCH_HOST_DIR="$(cd "$(dirname "$ARCHIVIO")" >/dev/null 2>&1 && pwd)"
	ARCH_FILE="$(basename "$ARCHIVIO")"

	L_FOLDER=$(t cli.label.folder)
	L_ARCHIVE=$(t cli.label.archive)
	W=$(colonna 11 "$L_FOLDER" "$L_ARCHIVE")
	say "$RAMO $(allinea "$W" "$L_FOLDER")$ARCH_HOST_DIR"
	say "$ULTIMO $(allinea "$W" "$L_ARCHIVE")${C1}$ARCH_FILE${C0} (${CGREEN}● $(t cli.state.found)${C0})"
	say ""

	# 2. Individua la destinazione dei dati
	DATA_SOURCE=""
	if docker container inspect "$NAME" >/dev/null 2>&1; then
		DATA_SOURCE="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME")"
	fi

	if [ -z "$DATA_SOURCE" ]; then
		if docker volume inspect "$VOLUME" >/dev/null 2>&1; then
			DATA_SOURCE="$VOLUME"
		else
			die "$(t cli.restore.no_data name "$NAME" volume "$VOLUME")"
		fi
	fi

	say "${C1}2. $(t cli.restore.step_destination)${C0}"
	say "$RAMO $(t cli.label.target) ${C1}$DATA_SOURCE${C0}"
	say "$ULTIMO ${CYELLOW}⚠️  $(t cli.restore.warning)${C0}"
	printf '%s ' "   $(t cli.restore.confirm)"
	read -r CONFERMA || CONFERMA=""
	# Si' in italiano o in inglese, qualunque sia la lingua della domanda.
	case "$CONFERMA" in
		[sS]|[sS][iI]|[yY]|[yY][eE][sS]) ;;
		*)
			say "$(t cli.restore.cancelled)"
			exit 0
			;;
	esac
	say ""

	# 3. Ferma il container se in esecuzione
	WAS_RUNNING=0
	if docker container inspect "$NAME" >/dev/null 2>&1; then
		if [ "$(docker inspect -f '{{.State.Running}}' "$NAME")" = "true" ]; then
			WAS_RUNNING=1
			say "${CCYAN}→${C0} $(t cli.restore.stopping name "$NAME")"
			docker stop "$NAME" >/dev/null
		fi
	fi

	say "${C1}3. $(t cli.restore.step_extract)${C0}"
	if docker run --rm -it --user 0:0 \
		--env ESTIA_LANG="$LINGUA" \
		-v "${ARCH_HOST_DIR}:/backup:ro" \
		-v "${DATA_SOURCE}:/restore" \
		--entrypoint node "$IMAGE" dist/backup/cli.js ripristina "/backup/${ARCH_FILE}" /restore --sovrascrivi; then

		if [ "$WAS_RUNNING" = "1" ]; then
			say ""
			say "${CCYAN}→${C0} $(t cli.restore.starting name "$NAME")"
			docker start "$NAME" >/dev/null
			say ""
			ok "${C1}$(t cli.restore.done)${C0}"
			L_STATE=$(t cli.label.state)
			L_OVERVIEW=$(t cli.label.overview)
			W=$(colonna 10 "$L_STATE" "$L_OVERVIEW")
			say "$RAMO $(allinea "$W" "$L_STATE")${C1}${CMD_STATO}${C0}"
			say "$ULTIMO $(allinea "$W" "$L_OVERVIEW")${C1}estia info${C0}"
		fi
	else
		if [ "$WAS_RUNNING" = "1" ]; then
			say ""
			say "${CYELLOW}→${C0} $(t cli.restore.failed_restarting)"
			docker start "$NAME" >/dev/null
		fi
		die "$(t cli.restore.failed)"
	fi
}

# risultato_aggiornamento — dove guardare dopo un aggiornamento.
risultato_aggiornamento() {
	L_STATE=$(t cli.label.state)
	L_LOGS=$(t cli.label.logs)
	W=$(colonna 10 "$L_STATE" "$L_LOGS")
	say "$RAMO $(allinea "$W" "$L_STATE")${C1}${CMD_STATO}${C0}"
	say "$ULTIMO $(allinea "$W" "$L_LOGS")${C1}estia logs -f${C0}"
}

cmd_aggiorna() {
	check_docker

	L_IMAGE=$(t cli.label.image)
	L_MODE=$(t cli.label.mode)
	L_PORT=$(t cli.label.port)
	L_VOLUME=$(t cli.label.volume)
	W=$(colonna 12 "$L_IMAGE" "$L_MODE" "$L_PORT" "$L_VOLUME")

	cornice "🔄" "$(t cli.update.title)"

	say "${C1}1. $(t cli.update.step_pull)${C0}"
	say "$RAMO $(allinea "$W" "$L_IMAGE")${IMAGE}"
	say "$ULTIMO $(t cli.update.pulling)"
	docker pull "$IMAGE"
	say ""

	say "${C1}2. $(t cli.update.step_recreate)${C0}"

	if docker container inspect "$NAME" >/dev/null 2>&1; then
		# Rileva se usava Compose
		WORKING_DIR="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$WORKING_DIR" ] && [ -d "$WORKING_DIR" ]; then
			say "$RAMO $(allinea "$W" "$L_MODE")$(t cli.update.mode_compose dir "$WORKING_DIR")"
			say "$ULTIMO $(t cli.update.applying)"
			(cd "$WORKING_DIR" && docker compose pull && docker compose up -d)
			say ""
			ok "${C1}$(t cli.update.done)${C0}"
			risultato_aggiornamento
			return
		fi

		# Se container standalone, estrai i parametri esistenti
		MOUNT_DATA="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		DETECTED_PORT="${DETECTED_PORT:-3000}"
		MOUNT_DATA="${MOUNT_DATA:-$VOLUME}"

		# La lingua con cui l'istanza e' stata installata (ADR 0044 §3) resta la
		# sua. Un container creato prima che esistesse ESTIA_LANG prende quella
		# in cui questo comando sta parlando, come farebbe install.sh.
		LINGUA_CONTAINER="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null | sed -n 's/^ESTIA_LANG=//p' | head -n 1)"
		LINGUA_CONTAINER="${LINGUA_CONTAINER:-$LINGUA}"

		say "$RAMO $(allinea "$W" "$L_MODE")$(t cli.update.mode_standalone name "$NAME")"
		say "$RAMO $(allinea "$W" "$L_PORT")${DETECTED_PORT}"
		say "$RAMO $(allinea "$W" "$L_VOLUME")${MOUNT_DATA} (${CGREEN}● $(t cli.state.data_kept)${C0})"
		say "$ULTIMO $(t cli.update.recreating)"

		docker rm -f "$NAME" >/dev/null

		docker run -d \
			--name "$NAME" \
			--restart unless-stopped \
			--publish "${DETECTED_PORT}:3000" \
			--volume "${MOUNT_DATA}:/data" \
			--env ESTIA_DATA_DIR=/data \
			--env ESTIA_HOST=0.0.0.0 \
			--env ESTIA_LANG="$LINGUA_CONTAINER" \
			--user 10001:10001 \
			--init \
			--read-only \
			--tmpfs /tmp \
			--cap-drop ALL \
			--security-opt no-new-privileges:true \
			--pids-limit 256 \
			"$IMAGE" >/dev/null

		say ""
		ok "${C1}$(t cli.update.done_restarted)${C0}"
		risultato_aggiornamento
		return
	fi

	# Fallback su install.sh se il container non esiste ancora
	avviso "$(t cli.update.not_present name "$NAME")"
	curl -fsSL "$INSTALL_URL" | ESTIA_LANG="$LINGUA" sh
}

# --- Main Dispatcher ---

COMMAND="${1:-info}"
if [ $# -gt 0 ]; then
	shift
fi

case "$COMMAND" in
	info|informazioni)
		cmd_info "$@"
		;;
	ripristino-backup|ripristina-backup|ripristina|ripristino|restore)
		cmd_ripristina "$@"
		;;
	backup)
		cmd_backup "$@"
		;;
	chiavi|keys)
		cmd_chiavi "$@"
		;;
	logs|log)
		cmd_logs "$@"
		;;
	stato|status)
		cmd_stato "$@"
		;;
	riavvia|restart)
		cmd_riavvia "$@"
		;;
	aggiorna|update|upgrade)
		cmd_aggiorna "$@"
		;;
	aiuto|help|--help|-h)
		mostra_aiuto
		;;
	*)
		die "$(t cli.unknown_command command "$COMMAND" help "$CMD_AIUTO")"
		;;
esac
