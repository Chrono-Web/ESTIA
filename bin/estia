#!/bin/sh
#
# ESTIA — CLI di gestione dell'istanza
#
# Script di utilita' per amministrare ESTIA dalla macchina host:
# permette di ripristinare backup, eseguirli, vedere i log e aggiornare
# l'istanza con comandi brevi e a prova di errore.
#
# Parla la lingua che gli si chiede (ADR 0044 §3): `ESTIA_LANG`, poi la lingua
# predefinita dell'istanza a cui parla, poi `LC_ALL`, `LC_MESSAGES` e `LANG`,
# poi l'inglese.

set -eu

IMAGE="${ESTIA_IMAGE:-ghcr.io/chrono-web/estia:latest}"
NAME="${ESTIA_CONTAINER:-estia}"
VOLUME="${ESTIA_VOLUME:-estia-data}"
DOCS_URL="https://github.com/chrono-web/estia"
INSTALL_URL="https://raw.githubusercontent.com/chrono-web/estia/main/install.sh"

# --- Lingua (ADR 0044) -------------------------------------------------------
#
# Le frasi non stanno in questo file: stanno nei cataloghi di
# packages/i18n/locales, e il blocco fra i due segni qui sotto lo scrive
# `pnpm i18n`. Lo script ci mette i colori, le cornici e i valori. Le funzioni
# che lo seguono sono le stesse di install.sh: questo file viene copiato da
# solo sull'host, e non puo' leggerle da li'.

# i18n:inizio — generato da `pnpm i18n` da packages/i18n/locales. Non modificare a mano.
