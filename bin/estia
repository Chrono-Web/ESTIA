#!/bin/sh
#
# ESTIA — CLI di gestione dell'istanza
#
# Script di utilita' per amministrare ESTIA dalla macchina host:
# permette di ripristinare backup, eseguirli, vedere i log e aggiornare
# l'istanza con comandi brevi e a prova di errore.

set -eu

IMAGE="${ESTIA_IMAGE:-ghcr.io/chrono-web/estia:latest}"
NAME="${ESTIA_CONTAINER:-estia}"
VOLUME="${ESTIA_VOLUME:-estia-data}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	C0="\033[0m"
	C1="\033[1m"
	CDIM="\033[2m"
	CCYAN="\033[1;36m"
	CBLUE="\033[4;34m"
	CGREEN="\033[32m"
	CYELLOW="\033[33m"
	CRED="\033[31m"
else
	C0=""
	C1=""
	CDIM=""
	CCYAN=""
	CBLUE=""
	CGREEN=""
	CYELLOW=""
	CRED=""
fi

say() {
	printf '%s\n' "$*"
}

sayb() {
	printf '%b\n' "$*"
}

die() {
	printf '\n%b\n' "${CRED}${C1}ERRORE${C0} $*" >&2
	exit 1
}

ok() {
	sayb "${CGREEN}●${C0} $*"
}

avviso() {
	sayb "${CYELLOW}○${C0} $*"
}

intestazione() {
	titolo="${1:-ESTIA}"
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🏡 ${titolo}
╚════════════════════════════════════════════════════════════════════╝${C0}"
}

sezione() {
	sayb ""
	sayb "$1 ${C1}$2${C0}"
}

check_docker() {
	if ! command -v docker >/dev/null 2>&1; then
		die "Docker non e' installato o non si trova nel PATH."
	fi
	if ! docker info >/dev/null 2>&1; then
		die "Docker non risponde. Assicurati che il servizio sia attivo e il tuo utente appartenga al gruppo 'docker'."
	fi
}

mostra_aiuto() {
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🏡 ESTIA — CLI di gestione locale                                 ║
╚════════════════════════════════════════════════════════════════════╝${C0}

🛠  ${C1}COMANDI DISPONIBILI${C0}
   ${CCYAN}├──${C0} ${C1}estia info${C0}                  Panoramica, URL di accesso e stato
   ${CCYAN}├──${C0} ${C1}estia stato${C0}                 Dettagli Docker: immagine, volumi, avvio
   ${CCYAN}├──${C0} ${C1}estia ripristino-backup${C0}     Ripristina da un backup cifrato
   ${CCYAN}├──${C0} ${C1}estia backup${C0}                Backup immediato dell'istanza accesa
   ${CCYAN}├──${C0} ${C1}estia chiavi${C0}                Nuova coppia di chiavi age
   ${CCYAN}├──${C0} ${C1}estia logs [-f]${C0}             Log (con -f li segue in tempo reale)
   ${CCYAN}├──${C0} ${C1}estia aggiorna${C0}              Aggiorna all'ultima versione
   ${CCYAN}├──${C0} ${C1}estia riavvia${C0}               Riavvio del container
   ${CCYAN}└──${C0} ${C1}estia aiuto${C0}                 Questo elenco

📖 ${CDIM}Documentazione: https://github.com/chrono-web/estia${C0}
"
}

cmd_info() {
	check_docker

	HOSTNAME_LOCAL="$(hostname 2>/dev/null | cut -d. -f1)"
	HOSTNAME_LOCAL="${HOSTNAME_LOCAL:-localhost}"

	STATUS="non presente"
	PORT="3000"
	DATA_MOUNT="estia-data (volume default)"
	BACKUP_MOUNT="/data/backup"

	if docker container inspect "$NAME" >/dev/null 2>&1; then
		IS_RUNNING="$(docker inspect -f '{{.State.Running}}' "$NAME")"
		if [ "$IS_RUNNING" = "true" ]; then
			STATUS="${CGREEN}● in esecuzione${C0}"
		else
			STATUS="${CYELLOW}○ fermo${C0}"
		fi

		DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$DETECTED_PORT" ]; then
			PORT="$DETECTED_PORT"
		fi

		MOUNT_DATA="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$MOUNT_DATA" ]; then
			DATA_MOUNT="$MOUNT_DATA"
		fi

		MOUNT_BACKUP="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data/backup"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$MOUNT_BACKUP" ]; then
			BACKUP_MOUNT="$MOUNT_BACKUP"
		fi
	fi

	printf '%b\n' "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🏡 ESTIA — Bacheca e messaggi privati per la tua casa             ║
╚════════════════════════════════════════════════════════════════════╝${C0}

📍 ${C1}ACCESSO ALL'ISTANZA${C0}
   ${CCYAN}├──${C0} Web:            ${CBLUE}http://${HOSTNAME_LOCAL}.local:${PORT}${C0}
   ${CCYAN}├──${C0} Container:      ${NAME} (${STATUS})
   ${CCYAN}└──${C0} Porta:          ${PORT}

💾 ${C1}DATI E BACKUP (sul NAS)${C0}
   ${CCYAN}├──${C0} Volume dati:    ${DATA_MOUNT} → /data
   ${CCYAN}└──${C0} Backup:         ${BACKUP_MOUNT}

🔐 ${C1}CRITTOGRAFIA & PRIVACY${C0}
   ${CCYAN}├──${C0} Backup cifrati: Age (X25519) — la chiave privata non tocca il server
   ${CCYAN}└──${C0} Messaggi:       E2E cifrati (MLS RFC 9420) — nessun testo in chiaro sul NAS

🛠  ${C1}COMANDI UTILI${C0}
   ${CCYAN}├──${C0} ${C1}estia info${C0}                  Mostra questa panoramica
   ${CCYAN}├──${C0} ${C1}estia stato${C0}                 Dettagli tecnici e diagnostica Docker
   ${CCYAN}├──${C0} ${C1}estia ripristino-backup${C0}     Ripristina un backup cifrato
   ${CCYAN}├──${C0} ${C1}estia backup${C0}                Esegue un backup immediato
   ${CCYAN}├──${C0} ${C1}estia chiavi${C0}                Nuova coppia di chiavi age
   ${CCYAN}├──${C0} ${C1}estia logs -f${C0}               Visualizza i log in tempo reale
   ${CCYAN}├──${C0} ${C1}estia aggiorna${C0}              Aggiorna all'ultima versione
   ${CCYAN}└──${C0} ${C1}estia riavvia${C0}               Riavvia il container

📖 ${CDIM}Il codice di configurazione e' in cima ai log: estia logs${C0}
📖 ${CDIM}Documentazione e codice: https://github.com/chrono-web/estia${C0}
"
}

cmd_chiavi() {
	check_docker
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🔑 ESTIA — Generazione chiavi di backup (Age X25519)              ║
╚════════════════════════════════════════════════════════════════════╝${C0}"
	docker run --rm --entrypoint node "$IMAGE" dist/backup/cli.js chiavi
}

cmd_logs() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "Il container «${NAME}» non esiste."
	fi
	docker logs "$@" "$NAME"
}

cmd_stato() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  📊 ESTIA — Diagnostica e stato del container                      ║
╚════════════════════════════════════════════════════════════════════╝${C0}"
		avviso "Container «${NAME}»: non presente sull'host."
		sayb "   ${CCYAN}├──${C0} Per installarlo: ${C1}curl -fsSL https://raw.githubusercontent.com/chrono-web/estia/main/install.sh | sh${C0}"
		sayb "   ${CCYAN}└──${C0} Documentazione:  ${CBLUE}https://github.com/chrono-web/estia${C0}"
		return
	fi

	STATUS_RAW="$(docker inspect -f '{{.State.Status}}' "$NAME")"
	if [ "$STATUS_RAW" = "running" ]; then
		STATUS="${CGREEN}● in esecuzione${C0}"
	else
		STATUS="${CYELLOW}○ ${STATUS_RAW}${C0}"
	fi
	IMAGE_ID="$(docker inspect -f '{{.Config.Image}}' "$NAME")"
	CREATED="$(docker inspect -f '{{.Created}}' "$NAME" | cut -d. -f1 | tr 'T' ' ')"
	STARTED="$(docker inspect -f '{{.State.StartedAt}}' "$NAME" | cut -d. -f1 | tr 'T' ' ')"
	DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
	DETECTED_PORT="${DETECTED_PORT:-3000}"

	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  📊 ESTIA — Diagnostica e stato del container                      ║
╚════════════════════════════════════════════════════════════════════╝${C0}"

	sezione "📍" "CONTAINER & PROCESSO"
	sayb "   ${CCYAN}├──${C0} Nome:         ${C1}$NAME${C0} ($STATUS)"
	sayb "   ${CCYAN}├──${C0} Immagine:     $IMAGE_ID"
	sayb "   ${CCYAN}├──${C0} Porta:        ${DETECTED_PORT} → 3000 (host:container)"
	sayb "   ${CCYAN}├──${C0} Creazione:    $CREATED"
	sayb "   ${CCYAN}└──${C0} Ultimo avvio: $STARTED"

	sezione "💾" "MONTAGGI & PERSISTENZA"
	docker inspect -f '{{range .Mounts}}   ${CCYAN}├──${C0} {{.Type}}: {{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}} → {{.Destination}}{{"\n"}}{{end}}' "$NAME"
	sayb "   ${CCYAN}└──${C0} Isolamento:   Filesystem in sola lettura (tranne /data e /tmp)"

	sezione "🔒" "SICUREZZA & PERMESSI"
	sayb "   ${CCYAN}├──${C0} Utente:       non-root (10001:10001)"
	sayb "   ${CCYAN}├──${C0} Privilegi:    no-new-privileges:true, cap-drop ALL"
	sayb "   ${CCYAN}└──${C0} Limite PID:   256 processi"

	sezione "🛠 " "AZIONI UTILI"
	sayb "   ${CCYAN}├──${C0} ${C1}estia logs -f${C0}   Visualizza i log in tempo reale"
	sayb "   ${CCYAN}├──${C0} ${C1}estia riavvia${C0}   Riavvia il container"
	sayb "   ${CCYAN}└──${C0} ${C1}estia backup${C0}    Esegue un backup immediato"
}

cmd_riavvia() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "Il container «${NAME}» non esiste."
	fi
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🔄 ESTIA — Riavvio del container                                  ║
╚════════════════════════════════════════════════════════════════════╝${C0}"
	sayb "${CCYAN}→${C0} Riavvio «${NAME}» in corso…"
	docker restart "$NAME" >/dev/null
	sayb ""
	ok "${C1}Container «${NAME}» riavviato con successo.${C0}"
	sayb "   ${CCYAN}├──${C0} Stato:    ${CGREEN}● in esecuzione${C0}"
	sayb "   ${CCYAN}├──${C0} Diagnosi: ${C1}estia stato${C0}"
	sayb "   ${CCYAN}└──${C0} Log:      ${C1}estia logs -f${C0}"
}

cmd_backup() {
	check_docker
	if ! docker container inspect "$NAME" >/dev/null 2>&1; then
		die "Il container «${NAME}» non esiste o non e' in esecuzione."
	fi
	DEST="${1:-/data/backup}"
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  💾 ESTIA — Backup immediato dei dati                              ║
╚════════════════════════════════════════════════════════════════════╝${C0}"
	sayb "${CCYAN}→${C0} Eseguo il backup cifrato in ${C1}${DEST}${C0}…"
	sayb ""
	docker exec -it "$NAME" node dist/backup/cli.js backup "$DEST"
}

cmd_ripristina() {
	check_docker
	ARCHIVIO="${1:-}"

	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🔐 ESTIA — Ripristino da backup                                   ║
╚════════════════════════════════════════════════════════════════════╝${C0}"

	# 1. Chiedi il file se non passato come argomento
	sayb "${C1}1. File di backup${C0}"
	if [ -z "$ARCHIVIO" ]; then
		sayb "   Incolla il percorso del file .tar.age (oppure trascinalo qui nel terminale):"
		printf "   > "
		read -r ARCHIVIO
	fi

	# Pulizia percorso (rimuove apici singoli o doppi aggiunti dai terminali con drag & drop)
	ARCHIVIO="$(printf '%s' "$ARCHIVIO" | sed -e "s/^['\"]//" -e "s/['\"]$//")"
	case "$ARCHIVIO" in
		"~"*) ARCHIVIO="$HOME${ARCHIVIO#\~}" ;;
	esac

	if [ -z "$ARCHIVIO" ]; then
		die "Nessun percorso fornito. Operazione annullata."
	fi

	if [ ! -f "$ARCHIVIO" ]; then
		die "Il file «${ARCHIVIO}» non esiste o non è leggibile."
	fi

	ARCH_HOST_DIR="$(cd "$(dirname "$ARCHIVIO")" >/dev/null 2>&1 && pwd)"
	ARCH_FILE="$(basename "$ARCHIVIO")"

	sayb "   ${CCYAN}├──${C0} Cartella:  $ARCH_HOST_DIR"
	sayb "   ${CCYAN}└──${C0} Archivio:  ${C1}$ARCH_FILE${C0} (${CGREEN}● trovato${C0})"
	sayb ""

	# 2. Individua la destinazione dei dati
	DATA_SOURCE=""
	if docker container inspect "$NAME" >/dev/null 2>&1; then
		DATA_SOURCE="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME")"
	fi

	if [ -z "$DATA_SOURCE" ]; then
		if docker volume inspect "$VOLUME" >/dev/null 2>&1; then
			DATA_SOURCE="$VOLUME"
		else
			die "Non riesco a trovare il volume o la cartella dati. Assicurati che esista il container «${NAME}» o il volume «${VOLUME}»."
		fi
	fi

	sayb "${C1}2. Destinazione dei dati${C0}"
	sayb "   ${CCYAN}├──${C0} Volume/Percorso: ${C1}$DATA_SOURCE${C0}"
	sayb "   ${CCYAN}└──${C0} ${CYELLOW}⚠️  Attenzione: il ripristino sostituirà i dati dell'istanza con quelli del backup.${C0}"
	printf "   Vuoi procedere con il ripristino? [s/N]: "
	read -r CONFERMA
	case "$CONFERMA" in
		[sS]|[sS][iI]|[yY]|[yY][eE][sS]) ;;
		*)
			sayb "Operazione annullata."
			exit 0
			;;
	esac
	sayb ""

	# 3. Ferma il container se in esecuzione
	WAS_RUNNING=0
	if docker container inspect "$NAME" >/dev/null 2>&1; then
		if [ "$(docker inspect -f '{{.State.Running}}' "$NAME")" = "true" ]; then
			WAS_RUNNING=1
			sayb "${CCYAN}→${C0} Fermo temporaneamente il container «${NAME}»…"
			docker stop "$NAME" >/dev/null
		fi
	fi

	sayb "${C1}3. Decifratura ed estrazione${C0}"
	if docker run --rm -it --user 0:0 \
		-v "${ARCH_HOST_DIR}:/backup:ro" \
		-v "${DATA_SOURCE}:/restore" \
		--entrypoint node "$IMAGE" dist/backup/cli.js ripristina "/backup/${ARCH_FILE}" /restore --sovrascrivi; then

		if [ "$WAS_RUNNING" = "1" ]; then
			sayb ""
			sayb "${CCYAN}→${C0} Riavvio l'istanza «${NAME}» con i dati ripristinati…"
			docker start "$NAME" >/dev/null
			sayb ""
			ok "${C1}Istanza riavviata e pronta con tutti i dati!${C0}"
			sayb "   ${CCYAN}├──${C0} Stato:    ${C1}estia stato${C0}"
			sayb "   ${CCYAN}└──${C0} Panoramica: ${C1}estia info${C0}"
		fi
	else
		if [ "$WAS_RUNNING" = "1" ]; then
			sayb ""
			sayb "${CYELLOW}→${C0} Ripristino non riuscito. Riavvio il container con i dati precedenti…"
			docker start "$NAME" >/dev/null
		fi
		die "Ripristino non completato."
	fi
}

cmd_aggiorna() {
	check_docker
	sayb "
${CCYAN}╔════════════════════════════════════════════════════════════════════╗
║  🔄 ESTIA — Aggiornamento dell'istanza                             ║
╚════════════════════════════════════════════════════════════════════╝${C0}"

	sayb "${C1}1. Download dell'immagine${C0}"
	sayb "   ${CCYAN}├──${C0} Immagine:   ${IMAGE}"
	sayb "   ${CCYAN}└──${C0} Scarico l'ultima versione disponibile…"
	docker pull "$IMAGE"
	sayb ""

	sayb "${C1}2. Ricreazione del container${C0}"

	if docker container inspect "$NAME" >/dev/null 2>&1; then
		# Rileva se usava Compose
		WORKING_DIR="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$NAME" 2>/dev/null || true)"
		if [ -n "$WORKING_DIR" ] && [ -d "$WORKING_DIR" ]; then
			sayb "   ${CCYAN}├──${C0} Modalità:   Docker Compose in ${WORKING_DIR}"
			sayb "   ${CCYAN}└──${C0} Applico l'aggiornamento…"
			(cd "$WORKING_DIR" && docker compose pull && docker compose up -d)
			sayb ""
			ok "${C1}Istanza aggiornata con successo!${C0}"
			sayb "   ${CCYAN}├──${C0} Stato:    ${C1}estia stato${C0}"
			sayb "   ${CCYAN}└──${C0} Log:      ${C1}estia logs -f${C0}"
			return
		fi

		# Se container standalone, estrai i parametri esistenti
		MOUNT_DATA="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		DETECTED_PORT="$(docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
		DETECTED_PORT="${DETECTED_PORT:-3000}"
		MOUNT_DATA="${MOUNT_DATA:-$VOLUME}"

		sayb "   ${CCYAN}├──${C0} Modalità:   Container standalone («${NAME}»)"
		sayb "   ${CCYAN}├──${C0} Porta:      ${DETECTED_PORT}"
		sayb "   ${CCYAN}├──${C0} Volume:     ${MOUNT_DATA} (${CGREEN}● dati preservati${C0})"
		sayb "   ${CCYAN}└──${C0} Ricreo e avvio il container…"

		docker rm -f "$NAME" >/dev/null

		docker run -d \
			--name "$NAME" \
			--restart unless-stopped \
			--publish "${DETECTED_PORT}:3000" \
			--volume "${MOUNT_DATA}:/data" \
			--env ESTIA_DATA_DIR=/data \
			--env ESTIA_HOST=0.0.0.0 \
			--user 10001:10001 \
			--init \
			--read-only \
			--tmpfs /tmp \
			--cap-drop ALL \
			--security-opt no-new-privileges:true \
			--pids-limit 256 \
			"$IMAGE" >/dev/null

		sayb ""
		ok "${C1}Istanza aggiornata e riavviata con successo!${C0}"
		sayb "   ${CCYAN}├──${C0} Stato:    ${C1}estia stato${C0}"
		sayb "   ${CCYAN}└──${C0} Log:      ${C1}estia logs -f${C0}"
		return
	fi

	# Fallback su install.sh se il container non esiste ancora
	avviso "Container «${NAME}» non presente. Avvio l'installazione iniziale…"
	curl -fsSL https://raw.githubusercontent.com/chrono-web/estia/main/install.sh | sh
}

# --- Main Dispatcher ---

COMMAND="${1:-info}"
if [ $# -gt 0 ]; then
	shift
fi

case "$COMMAND" in
	info|informazioni)
		cmd_info "$@"
		;;
	ripristino-backup|ripristina-backup|ripristina|ripristino|restore)
		cmd_ripristina "$@"
		;;
	backup)
		cmd_backup "$@"
		;;
	chiavi|keys)
		cmd_chiavi "$@"
		;;
	logs|log)
		cmd_logs "$@"
		;;
	stato|status)
		cmd_stato "$@"
		;;
	riavvia|restart)
		cmd_riavvia "$@"
		;;
	aggiorna|update|upgrade)
		cmd_aggiorna "$@"
		;;
	aiuto|help|--help|-h)
		mostra_aiuto
		;;
	*)
		die "Comando sconosciuto: «${COMMAND}». Digita 'estia aiuto' per l'elenco."
		;;
esac
